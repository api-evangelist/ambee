{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ambee Air Quality NDVI API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "NDVI",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Latest NDVI by latitude and longitude",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ambeedata.com/ndvi/latest/by-lat-lng",
            "params": [
              {
                "name": "lat",
                "value": "",
                "type": "query",
                "description": "Latitude of the location."
              },
              {
                "name": "lng",
                "value": "",
                "type": "query",
                "description": "Longitude of the location."
              }
            ]
          },
          "docs": "Returns the most recent Normalized Difference Vegetation Index (NDVI/EVI) value for a coordinate."
        },
        {
          "info": {
            "name": "Historical NDVI by latitude and longitude",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ambeedata.com/ndvi/history/by-lat-lng",
            "params": [
              {
                "name": "lat",
                "value": "",
                "type": "query",
                "description": "Latitude of the location."
              },
              {
                "name": "lng",
                "value": "",
                "type": "query",
                "description": "Longitude of the location."
              },
              {
                "name": "from",
                "value": "",
                "type": "query"
              },
              {
                "name": "to",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Historical NDVI by latitude and longitude"
        }
      ]
    }
  ],
  "bundled": true
}